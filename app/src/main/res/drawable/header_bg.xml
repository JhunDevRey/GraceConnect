    <gradient
        android:angle="315"
        android:endColor="@color/maroon_dark"
        android:startColor="@color/maroon_primary" />
    <corners
        android:bottomLeftRadius="@dimen/header_corner_radius"
        android:bottomRightRadius="@dimen/header_corner_radius" />
</shape>
